# Reuse an installed dsh. An absolute entry path avoids npx updating the runtime:
# HARNESS2_DSH_COMMAND="node /absolute/path/to/node_modules/@deepseek-ai/dsh/lib/bin.js"
HARNESS2_DSH_COMMAND=dsh
HARNESS2_DSH_HOME=~/.dsh
# Read provider settings and custom plugin bundles from this profile. A private
# base+headless composition is created for each run; the source is never written.
HARNESS2_DSH_PROFILE=web
HARNESS2_DSH_MODEL=ds4-local/deepseek-v4-pro
HARNESS2_IMPROVER_CHANNEL=dsh
HARNESS2_IMPROVER_MODEL=ds4-local/deepseek-v4-pro
HARNESS2_DSH_PERMISSION_MODE=workspace-write
HARNESS2_RUNS_DIR=runs/deepseek
HARNESS2_PHASE_WIDTH=1
HARNESS2_PROPOSER_CONCURRENCY=1
SEARXNG_BASE_URL=http://127.0.0.1:8888
# Set the environment variable named by your provider's apiKeyEnv separately.
# Optional extra provider patches, applied before generated harness instructions:
# HARNESS2_DSH_PATCH=/absolute/path/provider.patch.yml
# WorkBuddy requires a provider patch with URLs accessible from its containers:
# HARNESS2_DSH_CONTAINER_PATCH=/absolute/path/container-provider.patch.yml
# HARNESS2_DSH_CONTAINER_ALLOWED_HOSTS=host.docker.internal,model.internal
# JobBench judging can use a separate OpenAI-compatible model endpoint:
# HARNESS2_JUDGE_MODEL=your-judge-model
# HARNESS2_JUDGE_BASE_URL=http://127.0.0.1:3083/v1
# HARNESS2_JUDGE_API_KEY=local
